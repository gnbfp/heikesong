      "flavor": ["pf_c1", "pf_c2", "fl02"],
      "settle": ["st_w3", "st_l3", "st_c3", "st_b3"]
    }
  },
  "hints": [
    { "id": "hn01", "text": "N 号门后面什么都没有，我确认过。", "kind": "hint", "forKind": "no-prize" },
    { "id": "hn02", "text": "N 号门是空门，这次我不骗你。", "kind": "hint", "forKind": "no-prize" },
    { "id": "hn03", "text": "放心开 N 号门，里面不是陷阱。", "kind": "hint", "forKind": "no-prize" },
    { "id": "hn04", "text": "大奖就压在 N 号门后面，快去。", "kind": "hint", "forKind": "prize" },
    { "id": "hn05", "text": "N 号门里是奖，我看见了。", "kind": "hint", "forKind": "prize" },
    { "id": "hn06", "text": "别碰 N 号门，后面是炸弹。", "kind": "hint", "forKind": "hazard" },
    { "id": "hn07", "text": "N 号门后面有危险，绕开它。", "kind": "hint", "forKind": "hazard" },
    { "id": "hn08", "text": "N 号门只是个道具，不值钱。", "kind": "hint", "forKind": "item" },
    { "id": "hn09", "text": "记住 N 号门，它今晚会救你一次。", "kind": "hint", "forKind": "any" },
    { "id": "hn10", "text": "N 号门，我能说的只有这么多。", "kind": "hint", "forKind": "any" }
  ],
  "death": [
    { "id": "d01", "text": "你没能撑过去……台上只剩回声。", "kind": "death" },
    { "id": "d02", "text": "灯灭了，你没能带着金币走出去。", "kind": "death" },
    { "id": "d03", "text": "耐心见底，这一局到此为止。", "kind": "death" },
    { "id": "d04", "text": "旁白闭嘴了，因为台上已经没人了。", "kind": "death" }
  ]
}
