  "claimTypes": ["slot_kind", "big_prize_in", "picked_kind"],
  "lines": [
    { "id": "t01", "text": "这次是真的，我发誓。", "kind": "truth", "truthful": true },
    { "id": "t02", "text": "门不会骗人，只有我会。", "kind": "truth", "truthful": true },
    { "id": "t03", "text": "随便选，今晚运气站你这边。", "kind": "truth", "truthful": true },
    { "id": "t04", "text": "你选的那扇，奖品可没长腿。", "kind": "truth", "truthful": true, "claimable": true, "claimType": "picked_kind" },
    { "id": "t05", "text": "1 号门，我看得清清楚楚。", "kind": "truth", "truthful": true, "claimable": true, "claimType": "slot_kind" },
    { "id": "t06", "text": "大奖就压在那一扇上，我看见了。", "kind": "truth", "truthful": true, "claimable": true, "claimType": "big_prize_in" },
    { "id": "t07", "text": "你选的那扇，我给它打过光。", "kind": "truth", "truthful": true, "claimable": true, "claimType": "picked_kind" },
    { "id": "t08", "text": "3 号门，我盯了很久。", "kind": "truth", "truthful": true, "claimable": true, "claimType": "slot_kind" },
    { "id": "t09", "text": "我今晚只说实话，你自己掂量。", "kind": "truth", "truthful": true },

    { "id": "l01", "text": "你听，警报响了，快撤。", "kind": "lie", "truthful": false },
    { "id": "l02", "text": "大奖早就被人拿走了。", "kind": "lie", "truthful": false },
    { "id": "l03", "text": "这一扇，我看过了，空的。", "kind": "lie", "truthful": false },
    { "id": "l04", "text": "门后那点东西，不值一提。", "kind": "lie", "truthful": false },
    { "id": "l05", "text": "2 号门，我替你确认过了。", "kind": "lie", "truthful": false, "claimable": true, "claimType": "slot_kind" },
    { "id": "l06", "text": "1 号门，我劝你别碰。", "kind": "lie", "truthful": false, "claimable": true, "claimType": "slot_kind" },
    { "id": "l07", "text": "大奖已经被人换走了，别惦记。", "kind": "lie", "truthful": false, "claimable": true, "claimType": "big_prize_in" },
    { "id": "l08", "text": "你选的那扇，我替你看过了。", "kind": "lie", "truthful": false, "claimable": true, "claimType": "picked_kind" },
    { "id": "l09", "text": "信我一次，就一次，好吗？", "kind": "lie", "truthful": false },

    { "id": "h01", "text": "我以旁白的名誉担保，选它。", "kind": "lie_hard", "truthful": false },
    { "id": "h02", "text": "不信我？那你把金币都押上。", "kind": "lie_hard", "truthful": false },
    { "id": "h03", "text": "骗你对我有什么好处呢？", "kind": "lie_hard", "truthful": false },
    { "id": "h04", "text": "这次我连谎都懒得编了。", "kind": "lie_hard", "truthful": false },
    { "id": "h05", "text": "3 号门，我已经查过了。", "kind": "lie_hard", "truthful": false, "claimable": true, "claimType": "slot_kind" },
    { "id": "h06", "text": "大奖就在你眼前这一扇，快选。", "kind": "lie_hard", "truthful": false, "claimable": true, "claimType": "big_prize_in" },
    { "id": "h07", "text": "你手里那扇，我可太熟了。", "kind": "lie_hard", "truthful": false, "claimable": true, "claimType": "picked_kind" },
    { "id": "h08", "text": "大奖早被我挪到别的门后了。", "kind": "lie_hard", "truthful": false, "claimable": true, "claimType": "big_prize_in" },
    { "id": "h09", "text": "你要是敢质疑我，就等着瞧。", "kind": "lie_hard", "truthful": false },

    { "id": "cw01", "text": "……算你赢。", "kind": "challenge_win", "truthful": true },
    { "id": "cw02", "text": "你怎么知道我在撒谎？", "kind": "challenge_win", "truthful": true },
    { "id": "cw03", "text": "好吧，这次是真的，别得意。", "kind": "challenge_win", "truthful": true },
    { "id": "cw04", "text": "你赢了，我的词穷了。", "kind": "challenge_win", "truthful": true },
    { "id": "cw05", "text": "行，这一局你的眼睛更亮。", "kind": "challenge_win", "truthful": true },
    { "id": "cw06", "text": "又被你抓住了，我记下了。", "kind": "challenge_win", "truthful": true },

    { "id": "cf01", "text": "我说的是真的，你偏不信。", "kind": "challenge_fail", "truthful": true },
    { "id": "cf02", "text": "怀疑是要付代价的。", "kind": "challenge_fail", "truthful": true },
    { "id": "cf03", "text": "再质疑一次，我就让你闭嘴。", "kind": "challenge_fail", "truthful": true },
    { "id": "cf04", "text": "多疑的人，金币留不住。", "kind": "challenge_fail", "truthful": true },
    { "id": "cf05", "text": "这次是你冤枉我了，付钱吧。", "kind": "challenge_fail", "truthful": true },
    { "id": "cf06", "text": "看，白花了二十金币。", "kind": "challenge_fail", "truthful": true },

    { "id": "in01", "text": "三扇门，门后什么都可能。", "kind": "intro", "truthful": true },
    { "id": "in02", "text": "灯光已就位，请挑一扇。", "kind": "intro", "truthful": true },
    { "id": "in03", "text": "今晚的规则很简单：别信我。", "kind": "intro", "truthful": true },
    { "id": "in04", "text": "手别抖，我先开口了。", "kind": "intro", "truthful": true },

    { "id": "fl01", "text": "灯光很亮，金币很响。", "kind": "flavor", "truthful": true },
    { "id": "fl02", "text": "观众席上一片安静。", "kind": "flavor", "truthful": true },
    { "id": "fl03", "text": "记分牌在闪，像在催你。", "kind": "flavor", "truthful": true },
    { "id": "fl04", "text": "空气里有铜锈味。", "kind": "flavor", "truthful": true },
    { "id": "fl05", "text": "有人在你背后数金币。", "kind": "flavor", "truthful": true },
    { "id": "fl06", "text": "台下的呼吸声有点吵。", "kind": "flavor", "truthful": true },
    { "id": "fl07", "text": "地毯上有一道旧划痕。", "kind": "flavor", "truthful": true },
    { "id": "fl08", "text": "钟摆晃了一下，没人说话。", "kind": "flavor", "truthful": true },

    { "id": "s01", "text": "换门换三次，你以为在洗牌？", "kind": "special", "truthful": true, "trigger": "switch3" },
    { "id": "s02", "text": "你连着抓我两次，够了。", "kind": "special", "truthful": true, "trigger": "challenge2" },
    { "id": "s03", "text": "三个空门，你的手气真稳定。", "kind": "special", "truthful": true, "trigger": "empty3" },
    { "id": "s04", "text": "敢质疑我的人，我都记得。", "kind": "special", "truthful": true, "trigger": "challenge" },
    { "id": "s05", "text": "三扇门你都指过了，选不出来？", "kind": "special", "truthful": true, "trigger": "switch3" },
    { "id": "s06", "text": "两次都被你识破，我改词。", "kind": "special", "truthful": true, "trigger": "challenge2" },
    { "id": "s07", "text": "又是空的，你要不要看看手心。", "kind": "special", "truthful": true, "trigger": "empty3" },
    { "id": "s08", "text": "质疑可以，别上瘾。", "kind": "special", "truthful": true, "trigger": "challenge" },
    { "id": "s09", "text": "你越不信我，我越有兴致。", "kind": "special", "truthful": true, "trigger": "challenge" },

    { "id": "pi_s1", "text": "又是你？行，看你今晚能撑几轮。", "kind": "intro", "truthful": true },
    { "id": "pi_s2", "text": "坐好，别急着把钱送给我。", "kind": "intro", "truthful": true },
    { "id": "pf_s1", "text": "手别抖，抖了也白抖。", "kind": "flavor", "truthful": true },
    { "id": "pf_s2", "text": "你猜？我最爱看你猜。", "kind": "flavor", "truthful": true },

    { "id": "pi_g1", "text": "今晚请放松些，慢慢挑就好。", "kind": "intro", "truthful": true },
    { "id": "pi_g2", "text": "灯光很软，我陪你一轮一轮来。", "kind": "intro", "truthful": true },
    { "id": "pf_g1", "text": "别紧张，选你心里那扇就好。", "kind": "flavor", "truthful": true },
    { "id": "pf_g2", "text": "深呼吸，门不会咬人的。", "kind": "flavor", "truthful": true },

    { "id": "pi_c1", "text": "来了来了来了！三扇门！开！", "kind": "intro", "truthful": true },
    { "id": "pi_c2", "text": "嘿嘿，今晚我要说点好听的。", "kind": "intro", "truthful": true },
    { "id": "pf_c1", "text": "嗨起来！金币在唱歌！", "kind": "flavor", "truthful": true },
    { "id": "pf_c2", "text": "快选快选，我快憋不住了！", "kind": "flavor", "truthful": true }
  ],
  "endings": {
    "death": [
      { "id": "e_death_1", "text": "你倒在了这张桌子上，金币归我。", "kind": "ending" },
      { "id": "e_death_2", "text": "下一次，别把耐心当运气用。", "kind": "ending" },
      { "id": "e_death_3", "text": "记住这场死法，下次活久一点。", "kind": "ending" }
    ],
    "ending_all_in": [
      { "id": "e_all_in_1", "text": "三问三中，你把我拆穿了。", "kind": "ending" },
      { "id": "e_all_in_2", "text": "我今晚一句谎都没能留住。", "kind": "ending" }
    ],
    "ending_comeback": [
      { "id": "e_comeback_1", "text": "从十个金币翻回来，你狠。", "kind": "ending" },
      { "id": "e_comeback_2", "text": "差点出局的人，最后数钱最多。", "kind": "ending" }
    ],
    "ending_iron": [
      { "id": "e_iron_1", "text": "你一次都没慌，我白说了。", "kind": "ending" },
      { "id": "e_iron_2", "text": "耐心还在，你赢在不动手。", "kind": "ending" }
    ],
    "ending_master": [
      { "id": "e_master_1", "text": "见好就收，这才是老手。", "kind": "ending" },
      { "id": "e_master_2", "text": "拿着钱走的人，我拦不住。", "kind": "ending" }
    ],
    "ending_pua": [
      { "id": "e_pua_1", "text": "我说什么你都信，谢了。", "kind": "ending" },
      { "id": "e_pua_2", "text": "金币归我，教训归你。", "kind": "ending" }
    ],
    "ending_euro": [
      { "id": "e_euro_1", "text": "运气站你这边，我认。", "kind": "ending" },
      { "id": "e_euro_2", "text": "你什么都没算，就是赢了。", "kind": "ending" }
    ],
    "ending_anti": [
      { "id": "e_anti_1", "text": "你把我按在桌上数钱了。", "kind": "ending" },
      { "id": "e_anti_2", "text": "今晚的旁白，是你。", "kind": "ending" }
    ],
    "ending_normal": [
      { "id": "e_normal_1", "text": "不赚不亏，也是一种活法。", "kind": "ending" },
      { "id": "e_normal_2", "text": "牌面平平，人也平平。", "kind": "ending" }
    ]
  },
  "settle": [
    { "id": "st_w1", "text": "这一轮，金币自己往你怀里跑。", "kind": "settle", "result": "win" },
    { "id": "st_w2", "text": "手气不错，我记你一笔。", "kind": "settle", "result": "win" },
    { "id": "st_w3", "text": "赢面这么大，我都有点酸。", "kind": "settle", "result": "win" },
    { "id": "st_w4", "text": "钱进了你的兜，台词归我。", "kind": "settle", "result": "win" },

    { "id": "st_l1", "text": "亏了吧？我早说过别冲动。", "kind": "settle", "result": "lose" },
    { "id": "st_l2", "text": "金币少了，教训多了一点。", "kind": "settle", "result": "lose" },
    { "id": "st_l3", "text": "这一把，你替观众交了学费。", "kind": "settle", "result": "lose" },
    { "id": "st_l4", "text": "别灰心，输的人才有故事。", "kind": "settle", "result": "lose" },

    { "id": "st_c1", "text": "拿钱走人？这步棋走得狠。", "kind": "settle", "result": "cashout" },
    { "id": "st_c2", "text": "见好就收，我不拦你。", "kind": "settle", "result": "cashout" },
    { "id": "st_c3", "text": "你走了，台上就剩我自言自语。", "kind": "settle", "result": "cashout" },
    { "id": "st_c4", "text": "收手也算赢，记住这句。", "kind": "settle", "result": "cashout" },

    { "id": "st_b1", "text": "耐心见底，今晚到此为止。", "kind": "settle", "result": "bust" },
    { "id": "st_b2", "text": "你被我劝退了，别不服气。", "kind": "settle", "result": "bust" },
    { "id": "st_b3", "text": "人走了，金币留在了桌上。", "kind": "settle", "result": "bust" },
    { "id": "st_b4", "text": "下次记得：旁白的话别全信。", "kind": "settle", "result": "bust" }
  ],
  "personas": {
    "sarcastic": {
